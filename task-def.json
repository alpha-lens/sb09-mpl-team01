{
    "family": "mpl-task",
    "taskRoleArn": "arn:aws:iam::403884279316:role/mpl-ecs-task-role",
    "executionRoleArn": "arn:aws:iam::403884279316:role/ecsTaskExecutionRole",
    "networkMode": "bridge",
    "containerDefinitions": [
        {
            "name": "mpl-app",
            "image": "403884279316.dkr.ecr.ap-northeast-2.amazonaws.com/mpl-app:03b0fec357bbf1704c0ccf7f2dffdfad67c93f83",
            "cpu": 512,
            "memory": 900,
            "memoryReservation": 700,
            "portMappings": [
                {
                    "containerPort": 8080,
                    "hostPort": 8080,
                    "protocol": "tcp",
                    "name": "mpl-app-8080-tcp",
                    "appProtocol": "http"
                }
            ],
            "essential": true,
            "environment": [
                {
                    "name": "SPRING_ELASTICSEARCH_URIS",
                    "value": "https://vpc-mpl-opensearch-og76rj5n2vwlwjl4qylv3zg6da.ap-northeast-2.es.amazonaws.com"
                },
                {
                    "name": "OPENSEARCH_REGION",
                    "value": "ap-northeast-2"
                },
                {
                    "name": "OPENSEARCH_AUTH_MODE",
                    "value": "IAM"
                }
            ],
            "environmentFiles": [
                {
                    "value": "arn:aws:s3:::my-app-storage-mpl-2026-403884279316-ap-northeast-2-an/.env",
                    "type": "s3"
                }
            ],
            "mountPoints": [],
            "volumesFrom": [],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/mpl-task",
                    "awslogs-create-group": "true",
                    "awslogs-region": "ap-northeast-2",
                    "awslogs-stream-prefix": "ecs"
                }
            },
            "systemControls": []
        },
        {
            "name": "mpl-nginx",
            "image": "403884279316.dkr.ecr.ap-northeast-2.amazonaws.com/mpl-nginx@sha256:b85fa05b51a6f0419ecf90678c646d5865db4e4ed978097d25a4f22797fdff00",
            "cpu": 128,
            "memory": 128,
            "memoryReservation": 64,
            "links": [
                "mpl-app"
            ],
            "portMappings": [
                {
                    "containerPort": 80,
                    "hostPort": 80,
                    "protocol": "tcp",
                    "name": "mpl-nginx-80-tcp"
                }
            ],
            "essential": true,
            "environment": [],
            "mountPoints": [],
            "volumesFrom": [],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/mpl-task",
                    "awslogs-create-group": "true",
                    "awslogs-region": "ap-northeast-2",
                    "awslogs-stream-prefix": "ecs"
                }
            },
            "systemControls": []
        }
    ],
    "volumes": [],
    "placementConstraints": [],
    "runtimePlatform": {
        "cpuArchitecture": "X86_64",
        "operatingSystemFamily": "LINUX"
    },
    "requiresCompatibilities": [
        "EC2"
    ]
}
JWT_SECRET=change-me-minimum-32-bytes-long-secret-key
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
ADMIN_NAME=admin
TMDB_BEARER_TOKEN=change-me-tmdb-api-read-access-token

# ===== 소셜 로그인 (Google Cloud Console / Kakao Developers에서 발급) =====
GOOGLE_CLIENT_ID=****
GOOGLE_CLIENT_SECRET=****
KAKAO_CLIENT_ID=****
KAKAO_CLIENT_SECRET=****
FRONTEND_BASE_URL=http://localhost:8080

# ===== 메일 발송 (Gmail SMTP 앱 비밀번호) =====
MAIL_USERNAME=****
MAIL_PASSWORD=****

# ===== Spring App (docker-compose.yml : mpl-app) =====
SPRING_PROFILES_ACTIVE=prod
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379
SPRING_KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# ===== Zookeeper (docker-compose.yml, docker-compose-kafka.yml) =====
ZOOKEEPER_CLIENT_PORT=2181
ZOOKEEPER_TICK_TIME=2000

# ===== Kafka (docker-compose.yml, docker-compose-kafka.yml) =====
KAFKA_BROKER_ID=1
KAFKA_ZOOKEEPER_CONNECT=zookeeper:2181
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://kafka:9092,PLAINTEXT_HOST://localhost:29092
KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=PLAINTEXT:PLAINTEXT,PLAINTEXT_HOST:PLAINTEXT
KAFKA_INTER_BROKER_LISTENER_NAME=PLAINTEXT
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1

# ===== Storage (docker-compose.yml : mpl-app) =====
STORAGE_TYPE=local
STORAGE_LOCAL_ROOT_PATH=.mpl/storage

# ===== AWS S3 (STORAGE_TYPE=s3 일 때만 필요) =====
AWS_S3_ACCESS_KEY=****
AWS_S3_SECRET_KEY=****
AWS_S3_REGION=****
AWS_S3_BUCKET=****
AWS_S3_PRESIGNED_URL_EXPIRATION=600
{
  "family": "mpl-task",
  "executionRoleArn": "arn:aws:iam::403884279316:role/ecsTaskExecutionRole",
  "networkMode": "bridge",
  "requiresCompatibilities": [
    "EC2"
  ],
  "cpu": "512",
  "memory": "1024",
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "containerDefinitions": [
    {
      "name": "mpl-app",
      "image": "403884279316.dkr.ecr.ap-northeast-2.amazonaws.com/mpl-app:1.2-M9",
      "cpu": 384,
      "memory": 768,
      "memoryReservation": 512,
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8080,
          "hostPort": 8080,
          "protocol": "tcp",
          "name": "mpl-app-8080-tcp",
          "appProtocol": "http"
        }
      ],
      "environment": [],
      "environmentFiles": [
        {
          "value": "arn:aws:s3:::my-app-storage-mpl-2026-403884279316-ap-northeast-2-an/.env",
          "type": "s3"
        }
      ],
      "mountPoints": [],
      "volumesFrom": [],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/mpl-task",
          "awslogs-create-group": "true",
          "awslogs-region": "ap-northeast-2",
          "awslogs-stream-prefix": "mpl-app"
        }
      },
      "systemControls": []
    },
    {
      "name": "mpl-nginx",
      "image": "403884279316.dkr.ecr.ap-northeast-2.amazonaws.com/mpl-nginx:latest",
      "cpu": 128,
      "memory": 256,
      "memoryReservation": 128,
      "essential": true,
      "portMappings": [
        {
          "containerPort": 80,
          "hostPort": 80,
          "protocol": "tcp",
          "name": "mpl-nginx-80-tcp",
          "appProtocol": "http"
        }
      ],
      "links": [
        "mpl-app:mpl-app"
      ],
      "dependsOn": [
        {
          "containerName": "mpl-app",
          "condition": "START"
        }
      ],
      "mountPoints": [],
      "volumesFrom": [],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/mpl-task",
          "awslogs-create-group": "true",
          "awslogs-region": "ap-northeast-2",
          "awslogs-stream-prefix": "mpl-nginx"
        }
      },
      "systemControls": []
    }
  ],
  "volumes": [],
  "placementConstraints": []
}